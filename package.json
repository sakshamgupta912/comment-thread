{
  "name": "@fluent/comment-thread",
  "version": "0.1.0",
  "type": "module",
  "description": "A reusable, accessible Fluent UI React comment thread.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakshamgupta912/comment-thread.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "npm run build && node --test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@fluentui/react-components": ">=9.75.1 <10",
    "react": ">=19.3.1 <20",
    "react-dom": ">=19.3.1 <20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/react-components": "^9.75.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
