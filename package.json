{
  "name": "@fluent/comment-thread",
  "version": "0.1.0",
  "type": "module",
  "description": "A reusable, accessible Fluent UI React comment thread.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakshamgupta912/comment-thread.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "npm run build && publint && attw --pack . --profile esm-only",
    "test:browser": "node scripts/prepare-consumer.mjs && playwright test",
    "test:next": "node scripts/next-smoke.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run test:package",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@fluentui/react-components": ">=9.75.1 <10",
    "react": ">=18.3.1 <20",
    "react-dom": ">=18.3.1 <20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@fluentui/react-components": "^9.75.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
